# Copiaza in .env si completeaza. Aceleasi variabile se pun si pe Vercel.
# FARA niciuna dintre ele site-ul merge local, cu datele in .local/date.json
# si emailurile scrise in .local/emailuri.json.

# Adresa publica. Comanda canonical, sitemap si linkurile din emailuri.
PUBLIC_SITE_URL=https://dordefranceza.vercel.app

# Supabase: proiectul in care stau programarile si contul Dorinei.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Cheia de serviciu ramane DOAR pe server (nu are prefixul PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Resend, pentru emailuri. Expeditorul trebuie sa fie pe un domeniu verificat.
RESEND_API_KEY=re_...
# Virgula in numele afisat strica antetul From, deci numele ramane fara virgula.
EMAIL_DE=DorDeFranceza <dorina@send.dordefranceza.ro>
# Unde ajung notificarile daca nu e setat altceva in cabinet.
EMAIL_DORINA=dorina@exemplu.ro
# Numarul de WhatsApp al Dorinei, doar cifre cu prefix, pentru butonul din emailuri.
WHATSAPP_DORINA=40700000000
