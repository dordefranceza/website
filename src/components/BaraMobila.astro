---
/**
 * Bara fixa de jos, doar pe telefon: butonul de programare si WhatsApp la
 * degetul mare, oriunde ai fi in pagina. Apare dupa ce omul a derulat de
 * primul ecran, ca sa nu acopere antetul.
 */
import { Icon } from 'astro-icon/components'
import { linkWhatsApp } from '../config/site'
---

<div
  id="bara-mobila"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full bg-alb/90 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 shadow-[0_-12px_24px_-12px_rgba(75,68,57,0.18)] backdrop-blur-xl transition-transform duration-300 lg:hidden"
>
  <div class="flex items-center gap-2">
    <a href="/programare/" class="pastila pastila-albastra flex-1 !py-3.5">Programează gratuit</a>
    <a
      href={linkWhatsApp}
      target="_blank"
      rel="noopener"
      aria-label="Scrie pe WhatsApp"
      class="flex size-12 shrink-0 items-center justify-center rounded-full bg-verde-5"
    >
      <Icon name="whatsapp" class="size-6 text-verde" />
    </a>
  </div>
</div>

<script>
  // Apare dupa primul ecran si dispare cand ajungi la subsol, ca sa nu stea
  // peste butoanele de acolo.
  const bara = document.getElementById('bara-mobila')
  const subsol = document.querySelector('footer')
  if (bara) {
    const arata = () => {
      const trecutDePrimulEcran = window.scrollY > window.innerHeight * 0.6
      const laSubsol = subsol ? subsol.getBoundingClientRect().top < window.innerHeight : false
      const seVede = trecutDePrimulEcran && !laSubsol
      bara.classList.toggle('translate-y-full', !seVede)
      /* Bannerul de cookie-uri se ridica deasupra barei doar cat timp bara e
         chiar pe ecran. Artiom, la prima incarcare: „nu iti pare ca bannerul
         cookie este prea sus si are mult loc gol jos?". Avea dreptate: bannerul
         rezerva 96 de pixeli pentru o bara care apare abia dupa ce derulezi
         60% din primul ecran, deci exact cand bannerul se vede, sub el era gol. */
      document.documentElement.classList.toggle('bara-vizibila', seVede)
    }
    arata()
    window.addEventListener('scroll', arata, { passive: true })
  }
</script>
