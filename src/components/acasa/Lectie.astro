---
/**
 * Cum arată o lecție, minut cu minut. Sectiunea asta exista ca sa taie cea mai
 * tacuta obiectie a unui adult: nu stie ce se intampla in acele minute si
 * amana pana uita.
 *
 * Vorbea doar despre lectia de 50 de minute, desi la grup lectia tine 80.
 * Acum arata amandoua, socotite din aceeasi structura: `anatomiaLectiei` tine
 * cote, nu minute.
 */
import { Icon } from 'astro-icon/components'
import { anatomiaLectiei, minutele } from '../../config/continut'
import { site } from '../../config/site'
import Semn from '../Semn.astro'
import PersonajCerc from '../PersonajCerc.astro'
---

<section id="cum-arata" class="bg-crem py-20 sm:py-28" aria-labelledby="titlu-lectie">
  <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
    <div class="dezvaluie lg:sticky lg:top-32 lg:self-start">
      <p class="eticheta">Cum arată o lecție</p>
      <h2 id="titlu-lectie" class="mt-3 text-4xl sm:text-5xl">{site.durataLectie} sau {site.durataGrup} de minute în care vorbești tu</h2>
      <p class="echilibrat mt-5 text-lg text-gri">
        Nu te uiți la o prezentare și nu asculți o oră de gramatică. Lecția are aceeași structură de fiecare dată, ca să știi mereu unde ești.
      </p>
      <p class="echilibrat mt-3 text-gri">
        Individual ține {site.durataLectie} de minute. La grup, {site.durataGrup}: sunteți mai mulți și fiecare trebuie să apuce să vorbească.
      </p>
      <div class="mt-8 flex flex-col gap-3 rounded-[1.5rem] bg-alb p-6">
        <p class="flex items-start gap-3 text-[0.98rem]">
          <Icon name="solar:videocamera-record-bold" class="mt-0.5 size-5 shrink-0 text-albastru" />
          <span class="echilibrat">Pe Zoom, cu ecranul partajat. Nu ai nevoie de cont, intri dintr-un link.</span>
        </p>
        <p class="flex items-start gap-3 text-[0.98rem]">
          <Icon name="solar:document-add-bold" class="mt-0.5 size-5 shrink-0 text-albastru" />
          <span class="echilibrat">Materialele vin înainte de lecție. Nu cumperi niciun manual.</span>
        </p>
        <p class="flex items-start gap-3 text-[0.98rem]">
          <Icon name="solar:notebook-bookmark-bold" class="mt-0.5 size-5 shrink-0 text-albastru" />
          <span class="echilibrat">Rezumatul scris ajunge pe email în aceeași zi.</span>
        </p>
      </div>
      {/* Coloana asta se termina devreme, lista din dreapta tine mult mai mult:
          golul ramas il umple figura care scrie rezumatul. Doar de la 1024px,
          fiindca pe telefon coloanele se aseaza una sub alta si nu e niciun gol. */}
      <PersonajCerc nume="scrie" inel="albastru" disc="alb" marime={190} marimeMare={190} class="mt-4 hidden lg:block" />
    </div>

    <ol class="dezvaluie-rand space-y-3">
      {
        anatomiaLectiei.map((pas, i) => (
          <li class:list={['flex flex-col gap-2 rounded-[1.5rem] p-6 sm:flex-row sm:gap-8 sm:p-7', i % 2 === 0 ? 'bg-alb' : 'bg-albastru-5']}>
            <div class="shrink-0 sm:w-44">
              <p class="font-sans text-sm font-bold uppercase tracking-wider text-albastru-text">{pas.parte}</p>
              <p class="mt-1 text-sm text-gri">
                {minutele(pas.cota, site.durataLectie)} min <span class="text-gri/70">· {minutele(pas.cota, site.durataGrup)} la grup</span>
              </p>
            </div>
            <p class="leading-relaxed text-cerneala/85">{pas.ce}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
