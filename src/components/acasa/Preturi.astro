---
/**
 * Preturile. Structura vine dintr-o discutie de strategie cu Artiom:
 *
 *  1. lectia singura, 40 €, e ancora. E cea mai scumpa cale si asa si arata;
 *  2. pachetele au reduceri care chiar schimba o decizie, 10 pana la 22%.
 *     Cele de dinainte, 5 si 10%, erau decorative;
 *  3. grupul NU se vinde la bucata, ci ca un curs de doua luni cu loc rezervat:
 *     o grupa are nevoie ca aceiasi oameni sa vina la aceeasi ora, saptamani la
 *     rand. La 20 € pentru 80 de minute iese 15 € pe ora, adica exact media
 *     platformelor ieftine, deci raspunde obiectiei de pret fara sa scada
 *     pretul individual;
 *  4. un comutator intre individual si grup, ca omul sa nu se piarda in sapte
 *     carduri deodata.
 *
 * Preturile stau in `site.ts`, nu aici.
 */
import { Icon } from 'astro-icon/components'
import { beneficiiGrup, beneficiiIndividual, discutie } from '../../config/continut'
import { cursGrup, grupuri, pachete, site } from '../../config/site'
import Semn from '../Semn.astro'
import PersonajCerc from '../PersonajCerc.astro'
import CardPret from './CardPret.astro'

interface Props {
  titlu?: string
  compact?: boolean
}
const { titlu = 'Prețuri simple, fără abonament', compact = false } = Astro.props
---

<section id="preturi" class:list={['bg-crem', compact ? 'py-16' : 'py-20 sm:py-28']} aria-labelledby="titlu-preturi">
  <div class="container-site">
    <div class="dezvaluie mx-auto max-w-2xl text-center">
      <PersonajCerc nume="se-uita-jos-a" inel="portocaliu" disc="alb" marime={150} marimeMare={165} class="mx-auto mb-6" />
      <p class="eticheta">Prețuri</p>
      <h2 id="titlu-preturi" class="mt-3 text-4xl sm:text-5xl">{titlu}</h2>
      <p class="echilibrat mt-5 text-lg text-gri">
        Plătești lecțiile pe care le faci. Fără taxă de înscriere, fără abonament, fără manuale de cumpărat.
      </p>
    </div>

    {/* Discutia gratuita sta deasupra comutatorului: e valabila pentru amandoua. */}
    <div class="dezvaluie mt-12 flex flex-col items-start gap-6 rounded-[1.5rem] bg-alb p-7 sm:flex-row sm:items-center sm:p-9">
      {/* Aici era o bifă verde într-un cerc verde. Artiom: „e folosită de toate
          website-urile din lume". Acum stă ușa din familia noastră de semne,
          desenată o dată cu celelalte: discuția de cunoaștere chiar e ușa pe
          care intri, si e singura gratuită. Semnele noastre stau libere, fără
          rondea sub ele, ca în antet și la întrebări. */}
      <Semn nume="usa" inaltime={72} class="shrink-0" />
      <div class="flex-1">
        <p class="font-sans text-xl font-medium">{discutie.nume} <span class="text-verde">gratuită</span></p>
        <p class="echilibrat mt-1.5 text-gri">{discutie.detaliu}. {discutie.beneficii[2]}.</p>
      </div>
      <a href="/programare/?tip=cunoastere" class="pastila pastila-albastra shrink-0 !py-3">{discutie.buton}</a>
    </div>

    {/* Comutatorul. Cu tastatura merge cu sageti, ca orice set de file. */}
    <div class="dezvaluie mt-10 flex justify-center">
      <div class="inline-flex rounded-full bg-crem-inchis p-1.5" role="tablist" aria-label="Fel de lecții" data-file>
        <button
          type="button"
          role="tab"
          id="fila-individual"
          aria-selected="true"
          aria-controls="panou-individual"
          data-fila="individual"
          class="fila rounded-full px-6 py-2.5 text-[0.98rem] font-medium"
        >
          Individual
        </button>
        <button
          type="button"
          role="tab"
          id="fila-grup"
          aria-selected="false"
          aria-controls="panou-grup"
          data-fila="grup"
          tabindex="-1"
          class="fila rounded-full px-6 py-2.5 text-[0.98rem] font-medium"
        >
          În grup
        </button>
      </div>
    </div>

    {/* ---------------------------------------------------------------- individual */}
    <div id="panou-individual" role="tabpanel" aria-labelledby="fila-individual" tabindex="0">
      <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          pachete.map((p) => (
            <CardPret
              nume={p.nume}
              lectii={p.lectii}
              pretLectie={p.pretLectie}
              durata={site.durataLectie}
              baza={site.preturi.individual}
              nota={p.nota}
              evidentiat={p.evidentiat}
              href={`/programare/?tip=individual&pachet=${p.id}`}
            />
          ))
        }
      </div>

      <div class="mt-6 rounded-[1.5rem] bg-alb p-7 sm:p-9">
        <p class="font-sans text-lg font-medium">La orice lecție individuală primești</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            beneficiiIndividual.map((b) => (
              <li class="flex gap-3 text-[0.98rem]">
                <Icon name="solar:check-circle-bold" class="mt-0.5 size-5 shrink-0 text-verde" />
                <span class="leading-relaxed text-cerneala/85">{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* --------------------------------------------------------------------- grup */}
    <div id="panou-grup" role="tabpanel" aria-labelledby="fila-grup" tabindex="0" hidden>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          grupuri.map((g) => (
            <CardPret
              nume={g.nume}
              lectii={g.lectii}
              pretLectie={g.pretLectie}
              durata={site.durataGrup}
              baza={site.preturi.grup}
              nota={g.nota}
              evidentiat={g.evidentiat}
              eticheta="Cursul întreg"
              href={`/programare/?tip=grup&pachet=${g.id}`}
            />
          ))
        }
      </div>

      <div class="mt-6 grid gap-5 rounded-[1.5rem] bg-alb p-7 sm:p-9 lg:grid-cols-[1fr_1fr] lg:gap-10">
        <div>
          <p class="font-sans text-lg font-medium">Cum merge o grupă</p>
          <ul class="mt-5 space-y-3">
            {
              beneficiiGrup.map((b) => (
                <li class="flex gap-3 text-[0.98rem]">
                  <Icon name="solar:check-circle-bold" class="mt-0.5 size-5 shrink-0 text-verde" />
                  <span class="leading-relaxed text-cerneala/85">{b}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-[1.25rem] bg-crem p-6">
          <p class="font-sans font-medium">Cât costă o oră de lecție</p>
          <p class="echilibrat mt-2 text-sm leading-relaxed text-gri">
            Lecția de grup ține {site.durataGrup} de minute, nu {site.durataLectie}, fiindcă trebuie să apuce toată lumea
            să vorbească. La cursul întreg iese{' '}
            <strong class="font-medium text-cerneala">
              {Math.round((cursGrup.pretLectie * 60) / site.durataGrup)} {site.moneda} pe oră
            </strong>
            , adică exact cât costă o oră pe platformele cu profesori mulți.
          </p>
          <p class="echilibrat mt-4 text-sm leading-relaxed text-gri">
            Grupa pornește când se strâng {site.marimeGrup}. Până atunci nu plătești nimic: îți spun eu când e gata și
            abia atunci confirmi.
          </p>
        </div>
      </div>

    {/*
      Banda si figura sunt LIPITE, nu despartite: figura sta peste capatul din
      dreapta al benzii, dar asezata ca sa nu ramana verde nici dupa ea, nici pe
      sub arcul ei. `right-0` si `-bottom-4` sunt exact numerele care fac asta.
    */}
    {site.garantie.activa && (
      <div class="dezvaluie relative mt-6 flex flex-col items-start gap-5 rounded-[1.5rem] bg-verde-5 px-8 py-7 sm:flex-row sm:items-center sm:px-10 lg:mt-24 lg:pr-56 2xl:pr-64">
        {/* Sigiliul marcii, nu scutul din setul Solar pe care il are toata lumea.
            E singurul semn desenat in verde, fiindca sta in blocul verde. */}
        <span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-alb">
          <Semn nume="garantie" inaltime={38} />
        </span>
        <div>
          <h3 class="font-sans text-xl font-medium">Nu rămâi cu banii dați degeaba</h3>
          <p class="echilibrat mt-2 leading-relaxed text-cerneala/85">{site.garantie.text}</p>
        </div>
        <PersonajCerc nume="inima" inel="verde-10" disc="alb" marime={160} marimeMare={184} class="absolute -bottom-4 right-0 hidden lg:block" />
      </div>
    )}

    <p class="dezvaluie mt-6 text-center text-sm text-gri lg:mt-14">
      Prețurile sunt în euro. Suma în lei e trecută dedesubt, la cursul BNR, și se poate schimba puțin de la o zi la alta.
      Plata se face prin transfer bancar sau Revolut.
    </p>
  </div>
</section>

<style>
  .fila {
    color: var(--color-gri);
    transition:
      background-color 260ms var(--ease-afara),
      color 260ms var(--ease-afara);
  }
  .fila[aria-selected='true'] {
    background-color: var(--color-alb);
    color: var(--color-cerneala);
    box-shadow: var(--shadow-cald-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .fila { transition: none; }
  }
</style>

<script>
  // Comutatorul dintre lectii individuale si grup. Se poarta ca un set de file
  // adevarat: sagetile stanga si dreapta trec de la una la alta, iar fila care
  // nu e aleasa iese din drumul tastaturii.
  document.querySelectorAll<HTMLElement>('[data-file]').forEach((grup) => {
    const file = [...grup.querySelectorAll<HTMLButtonElement>('[data-fila]')]
    const panouri = file
      .map((f) => document.getElementById(f.getAttribute('aria-controls') ?? ''))
      .filter((p): p is HTMLElement => p !== null)

    const alege = (i: number, mutaFocus = false) => {
      file.forEach((f, k) => {
        f.setAttribute('aria-selected', String(k === i))
        f.tabIndex = k === i ? 0 : -1
      })
      panouri.forEach((p, k) => (p.hidden = k !== i))
      if (mutaFocus) file[i].focus()
    }

    file.forEach((f, i) => {
      f.addEventListener('click', () => alege(i))
      f.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return
        e.preventDefault()
        alege((i + (e.key === 'ArrowRight' ? 1 : file.length - 1)) % file.length, true)
      })
    })
  })
</script>
