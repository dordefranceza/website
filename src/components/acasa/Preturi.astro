---
/**
 * Preturile. Structura vine dintr-o discutie de strategie cu Artiom:
 *
 *  1. lectia singura, 40 €, e ancora. E cea mai scumpa cale si asa si arata;
 *  2. pachetele au reduceri care chiar schimba o decizie, 10 pana la 22%.
 *     Cele de dinainte, 5 si 10%, erau decorative;
 *  3. grupul NU se vinde la bucata, ci ca un curs de doua luni cu loc rezervat:
 *     o grupa are nevoie ca aceiasi oameni sa vina la aceeasi ora, saptamani la
 *     rand. La 20 € pentru 80 de minute iese 15 € pe ora, adica exact media
 *     platformelor ieftine, deci raspunde obiectiei de pret fara sa scada
 *     pretul individual;
 *  4. un comutator intre individual si grup, ca omul sa nu se piarda in sapte
 *     carduri deodata.
 *
 * Preturile stau in `site.ts`, nu aici.
 */
import { Icon } from 'astro-icon/components'
import { beneficiiGrup, beneficiiIndividual, discutie } from '../../config/continut'
import { cursGrup, grupuri, pachete, site } from '../../config/site'
import Semn from '../Semn.astro'
import PersonajCerc from '../PersonajCerc.astro'
import CardPret from './CardPret.astro'

interface Props {
  titlu?: string
  compact?: boolean
}
/*
 * Titlul spunea „Prețuri simple, fără abonament". Tehnic e adevărat, un pachet
 * nu e abonament: nu se reînnoiește singur și nu ia bani lunar. Dar Artiom s-a
 * împiedicat de el de două ori, iar daca se impiedica el se impiedica si
 * cititorul: sub titlu stau patru carduri, din care trei sunt pachete. Un
 * cuvant care are nevoie de explicatie nu isi merita locul intr-un titlu.
 *
 * Titlul de acum e ales de Artiom. Se tine: nu exista taxa de inscriere, nu se
 * cumpara manuale, si nu apare nimic pe drum. Randul de dedesubt spune si
 * pachetele, si ca lectiile nefacute se intorc.
 */
const { titlu = 'Prețuri cinstite, fără alte taxe', compact = false } = Astro.props
---

<section id="preturi" class:list={['bg-crem', compact ? 'py-16' : 'py-20 sm:py-28']} aria-labelledby="titlu-preturi">
  <div class="container-site">
    <div class="dezvaluie mx-auto max-w-2xl text-center">
      <PersonajCerc nume="se-uita-jos-a" inel="portocaliu" disc="alb" marime={150} marimeMare={165} class="mx-auto mb-6" />
      <p class="eticheta">Prețuri</p>
      <h2 id="titlu-preturi" class="mt-3 text-4xl sm:text-5xl">{titlu}</h2>
      {/*
        Scria „plătești lecțiile pe care le faci, fără taxă de înscriere, fără
        abonament". Artiom: „nu îmi place, și de ce ai scris fără abonament dacă
        noi avem pachete?" Avea dreptate, se bat cap în cap: un pachet de 24 de
        lecții plătit dinainte e chiar lucrul pe care rândul îl nega.

        Randul nou spune ce e de fapt oferta, si raspunde la cele doua temeri
        pe care nu le zice nimeni cu voce tare: ma leg de ceva? pierd banii daca
        ma opresc?
      */}
      <p class="echilibrat mt-5 text-lg text-gri">
        Plătești lecție cu lecție, sau iei un pachet și scade prețul pe lecție. Nimic nu se reînnoiește singur, iar lecțiile pe care nu le faci ți se întorc.
      </p>
    </div>

    {/* Discutia gratuita sta deasupra comutatorului: e valabila pentru amandoua. */}
    <div class="dezvaluie mt-12 flex flex-col items-start gap-6 rounded-[1.5rem] bg-alb p-7 sm:flex-row sm:items-center sm:p-9">
      {/* Aici era o bifă verde într-un cerc verde. Artiom: „e folosită de toate
          website-urile din lume".

          Prima încercare a fost ușa, ca metaforă pentru intrare. Artiom:
          „nu prea se potrivește". Avea dreptate, ușa spune „intri undeva", nu
          „vorbim".

          Puse toate patru în bandă și privite una sub alta, balonul e singurul
          care spune din prima privire despre ce e vorba. Cafeaua spune cafea,
          cornul spune corn, sămânța nu se citește la mărimea asta.

          Semnele noastre stau libere, fără rondea sub ele, ca în antet și la
          întrebări. */}
      <Semn nume="balon" inaltime={72} class="shrink-0" />
      <div class="flex-1">
        <p class="font-sans text-xl font-medium">{discutie.nume} <span class="text-verde">gratuită</span></p>
        <p class="echilibrat mt-1.5 text-gri">{discutie.detaliu}. {discutie.beneficii[2]}.</p>
      </div>
      <a href="/programare/?tip=cunoastere" class="pastila pastila-albastra shrink-0 !py-3">{discutie.buton}</a>
    </div>

    {/* Comutatorul. Cu tastatura merge cu sageti, ca orice set de file. */}
    <div class="dezvaluie mt-10 flex justify-center">
      <div class="comutator inline-flex rounded-full bg-crem-inchis p-1.5" role="tablist" aria-label="Fel de lecții" data-file>
        {/* Bulina alba care aluneca de la o fila la alta. Sta sub butoane, nu
            in ele: altfel „selectat" ar fi doua fundaluri care se sting si se
            aprind, adica exact saritura pe care a reclamat-o Artiom.
            Fara javascript nu apare deloc, iar fundalul ramane pe fila aleasa,
            ca inainte. */}
        <span class="bulina" aria-hidden="true"></span>
        <button
          type="button"
          role="tab"
          id="fila-individual"
          aria-selected="true"
          aria-controls="panou-individual"
          data-fila="individual"
          class="fila rounded-full px-6 py-2.5 text-[0.98rem] font-medium"
        >
          Individual
        </button>
        <button
          type="button"
          role="tab"
          id="fila-grup"
          aria-selected="false"
          aria-controls="panou-grup"
          data-fila="grup"
          tabindex="-1"
          class="fila rounded-full px-6 py-2.5 text-[0.98rem] font-medium"
        >
          În grup
        </button>
      </div>
    </div>

    {/* Invelisul exista ca sa se poata anima inaltimea intre cele doua panouri:
        individual are 632 de pixeli, grupul 1038. Fara el, jumatate de pagina
        sare dintr-o data. */}
    <div class="panouri" data-panouri>
    {/* ---------------------------------------------------------------- individual */}
    <div id="panou-individual" role="tabpanel" aria-labelledby="fila-individual" tabindex="0">
      <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          pachete.map((p) => (
            <CardPret
              nume={p.nume}
              lectii={p.lectii}
              pretLectie={p.pretLectie}
              durata={site.durataLectie}
              baza={site.preturi.individual}
              nota={p.nota}
              evidentiat={p.evidentiat}
              href={`/programare/?tip=individual&pachet=${p.id}`}
            />
          ))
        }
      </div>

      <div class="mt-6 rounded-[1.5rem] bg-alb p-7 sm:p-9">
        <p class="font-sans text-lg font-medium">La orice lecție individuală primești</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            beneficiiIndividual.map((b) => (
              <li class="flex gap-3 text-[0.98rem]">
                <Icon name="solar:check-circle-bold" class="mt-0.5 size-5 shrink-0 text-verde" />
                <span class="leading-relaxed text-cerneala/85">{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* --------------------------------------------------------------------- grup */}
    <div id="panou-grup" role="tabpanel" aria-labelledby="fila-grup" tabindex="0" hidden>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          grupuri.map((g) => (
            <CardPret
              nume={g.nume}
              lectii={g.lectii}
              pretLectie={g.pretLectie}
              durata={site.durataGrup}
              baza={site.preturi.grup}
              nota={g.nota}
              evidentiat={g.evidentiat}
              eticheta="Cursul întreg"
              href={`/programare/?tip=grup&pachet=${g.id}`}
            />
          ))
        }
      </div>

      <div class="mt-6 grid gap-5 rounded-[1.5rem] bg-alb p-7 sm:p-9 lg:grid-cols-[1fr_1fr] lg:gap-10">
        <div>
          <p class="font-sans text-lg font-medium">Cum merge o grupă</p>
          <ul class="mt-5 space-y-3">
            {
              beneficiiGrup.map((b) => (
                <li class="flex gap-3 text-[0.98rem]">
                  <Icon name="solar:check-circle-bold" class="mt-0.5 size-5 shrink-0 text-verde" />
                  <span class="leading-relaxed text-cerneala/85">{b}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-[1.25rem] bg-crem p-6">
          <p class="font-sans font-medium">Cât costă o oră de lecție</p>
          {/*
            Aici se impiedica si Artiom: cardul spune 20 € pe lectie, iar
            dedesubt scria 15 € pe ora, fara sa se vada de unde vine. Amandoua
            sunt adevarate, doar ca masoara altceva: una o lectie de 80 de
            minute, cealalta 60 de minute. Acum pasul e scris pe fata, ca nimeni
            sa nu-l mai faca in cap.

            Era si un spatiu inainte de virgula, de la `</strong>` pus pe randul
            lui: `{' '}` inaintea etichetei, nu dupa.
          */}
          <p class="echilibrat mt-2 text-sm leading-relaxed text-gri">
            Lecția de grup ține {site.durataGrup} de minute, nu {site.durataLectie}, fiindcă trebuie să apuce toată lumea
            să vorbească. Așa că {cursGrup.pretLectie} {site.moneda} pentru {site.durataGrup} de minute înseamnă{' '}
            <strong class="font-medium text-cerneala">{Math.round((cursGrup.pretLectie * 60) / site.durataGrup)} {site.moneda} pe oră</strong>, adică
            exact cât costă o oră pe platformele cu profesori mulți.
          </p>
          <p class="echilibrat mt-4 text-sm leading-relaxed text-gri">
            Grupa pornește când se strâng {site.marimeGrup}. Până atunci nu plătești nimic: îți spun eu când e gata și
            abia atunci confirmi.
          </p>
        </div>
      </div>
    </div>
    {/* Aici se inchidea panoul de grup. Nu se inchidea: lipsea `</div>`-ul, iar
        parserul il inchidea singur abia la capatul sectiunii. Efectul era ca
        banda de garantie si nota cu euro si lei cadeau INAUNTRUL panoului de
        grup, care porneste ascuns. Adica pe fila „Individual", cea implicita,
        nu se vedea nici garantia, nici pretul in lei. Se vedeau doar daca omul
        apasa pe „In grup". */}
    </div>

    {/*
      Banda si figura sunt LIPITE, nu despartite: figura sta peste capatul din
      dreapta al benzii, dar asezata ca sa nu ramana verde nici dupa ea, nici pe
      sub arcul ei. `right-0` si `-bottom-4` sunt exact numerele care fac asta.
    */}
    {site.garantie.activa && (
      <div class="dezvaluie relative mt-6 flex flex-col items-start gap-5 rounded-[1.5rem] bg-verde-5 px-8 py-7 sm:flex-row sm:items-center sm:px-10 lg:mt-24 lg:pr-56 2xl:pr-64">
        {/* Sigiliul marcii, nu scutul din setul Solar pe care il are toata lumea.
            E singurul semn desenat in verde, fiindca sta in blocul verde. */}
        <span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-alb">
          <Semn nume="garantie" inaltime={38} />
        </span>
        <div>
          <h3 class="font-sans text-xl font-medium">Nu rămâi cu banii dați degeaba</h3>
          <p class="echilibrat mt-2 leading-relaxed text-cerneala/85">{site.garantie.text}</p>
        </div>
        <PersonajCerc nume="inima" inel="verde-10" disc="alb" marime={160} marimeMare={184} class="absolute -bottom-4 right-0 hidden lg:block" />
      </div>
    )}

    {/*
      Aici era o nota de trei randuri: „Preturile sunt in euro, suma in lei e la
      cursul BNR, plata se face inainte de lectie". Artiom a cerut sa iasa, ocupa
      prea mult loc si pe calculator si pe telefon.

      Nu se pierde nimic. Suma in lei sta oricum sub fiecare pret, pe card, deci
      afisarea in lei e acoperita. Cand se plateste scrie pe cardul „O lectie",
      in intrebarile frecvente, pe pagina de preturi, pe „cum decurge" si in
      termeni. Iar ca leul e orientativ, la cursul zilei, scrie in termeni, unde
      conteaza daca se ajunge vreodata la discutie.
    */}
  </div>
</section>

<style>
  /* Comutatorul.
   *
   * Inainte, „selectat" insemna fundal alb pe buton. Cand treceai de la unul la
   * altul, un fundal se stingea si celalalt se aprindea, amandoua in acelasi
   * timp. Ochiul nu vede o miscare, vede o clipire. Artiom: „nu asa brusc care
   * taie ochii".
   *
   * Acum fundalul alb e un singur element, bulina, care aluneca dedesubt.
   * Latimea si pozitia le da javascriptul din butonul ales, fiindca cele doua
   * butoane au latimi diferite: „Individual" are 116 pixeli, „In grup" 99.
   *
   * Fara javascript, nimic nu se strica: bulina sta ascunsa si fundalul ramane
   * pe butonul ales, exact ca inainte.
   */
  .comutator { position: relative; }

  .fila {
    position: relative;
    z-index: 1;
    color: var(--color-gri);
    transition:
      background-color 260ms var(--ease-afara),
      color 260ms var(--ease-afara);
  }
  .fila[aria-selected='true'] {
    background-color: var(--color-alb);
    color: var(--color-cerneala);
    box-shadow: var(--shadow-cald-sm);
  }
  /* Cu javascript, bulina preia fundalul si butonul ramane doar cu textul. */
  .comutator.cu-bulina .fila[aria-selected='true'] {
    background-color: transparent;
    box-shadow: none;
  }

  .bulina {
    position: absolute;
    left: 0;
    top: 0;
    display: none;
    width: var(--bulina-l, 0px);
    height: var(--bulina-h, 0px);
    transform: translate(var(--bulina-x, 0px), var(--bulina-y, 0px));
    border-radius: 9999px;
    background-color: var(--color-alb);
    box-shadow: var(--shadow-cald-sm);
    pointer-events: none;
    transition:
      transform 420ms var(--ease-afara),
      width 420ms var(--ease-afara);
  }
  .comutator.cu-bulina .bulina { display: block; }
  /* La prima asezare si la redimensionarea ferestrei bulina se muta pe loc:
     altfel ar aluneca din coltul din stanga sus la incarcarea paginii. */
  .comutator.fara-tranzitie .bulina { transition: none; }

  /* Panoul care intra nu apare dintr-o data, ci se ridica putin si se limpezeste. */
  @keyframes panou-intra {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  .panou-intra { animation: panou-intra 380ms var(--ease-afara) both; }

  @media (prefers-reduced-motion: reduce) {
    .fila,
    .bulina { transition: none; }
    .panou-intra { animation: none; }
  }
</style>

<script>
  // Comutatorul dintre lectii individuale si grup. Se poarta ca un set de file
  // adevarat: sagetile stanga si dreapta trec de la una la alta, iar fila care
  // nu e aleasa iese din drumul tastaturii.
  //
  // Pe langa asta, misca bulina alba si trece inaltimea invelisului de la un
  // panou la altul. Panoul individual are 632 de pixeli, grupul 1038: fara
  // animatie, jumatate de pagina sare dintr-o data.
  document.querySelectorAll<HTMLElement>('[data-file]').forEach((grup) => {
    const file = [...grup.querySelectorAll<HTMLButtonElement>('[data-fila]')]
    const panouri = file
      .map((f) => document.getElementById(f.getAttribute('aria-controls') ?? ''))
      .filter((p): p is HTMLElement => p !== null)
    if (file.length === 0 || panouri.length !== file.length) return

    const invelis = grup.closest('section')?.querySelector<HTMLElement>('[data-panouri]') ?? null
    let curent = Math.max(0, file.findIndex((f) => f.getAttribute('aria-selected') === 'true'))

    /** Muta bulina peste butonul ales, luand marimile chiar de la el. */
    const asaza = (i: number) => {
      const f = file[i]
      grup.style.setProperty('--bulina-x', `${f.offsetLeft}px`)
      grup.style.setProperty('--bulina-y', `${f.offsetTop}px`)
      grup.style.setProperty('--bulina-l', `${f.offsetWidth}px`)
      grup.style.setProperty('--bulina-h', `${f.offsetHeight}px`)
    }

    /** Asezare fara alunecare: la pornire si cand se schimba latimea ferestrei. */
    const asazaPeLoc = () => {
      grup.classList.add('fara-tranzitie')
      asaza(curent)
      requestAnimationFrame(() => requestAnimationFrame(() => grup.classList.remove('fara-tranzitie')))
    }

    grup.classList.add('cu-bulina')
    asazaPeLoc()
    window.addEventListener('resize', asazaPeLoc)
    // Fonturile schimba latimea butoanelor cand ajung, deci bulina se reaseaza.
    document.fonts?.ready.then(asazaPeLoc)

    const linistit = window.matchMedia('(prefers-reduced-motion: reduce)')

    const alege = (i: number, mutaFocus = false) => {
      if (i === curent) {
        if (mutaFocus) file[i].focus()
        return
      }
      const vechi = panouri[curent]
      const nou = panouri[i]
      file.forEach((f, k) => {
        f.setAttribute('aria-selected', String(k === i))
        f.tabIndex = k === i ? 0 : -1
      })
      curent = i
      asaza(i)

      if (!invelis || linistit.matches) {
        vechi.hidden = true
        nou.hidden = false
        if (mutaFocus) file[i].focus()
        return
      }

      // Inaltimea de la care plecam, masurata inainte de schimb.
      const dela = invelis.getBoundingClientRect().height
      vechi.hidden = true
      nou.hidden = false
      nou.classList.remove('panou-intra')
      void nou.offsetWidth
      nou.classList.add('panou-intra')
      const la = invelis.getBoundingClientRect().height

      invelis.style.overflow = 'hidden'
      invelis.style.height = `${dela}px`
      void invelis.offsetHeight
      invelis.style.transition = 'height 420ms var(--ease-afara)'
      invelis.style.height = `${la}px`

      const gata = (e?: TransitionEvent) => {
        if (e && e.propertyName !== 'height') return
        invelis.style.height = ''
        invelis.style.overflow = ''
        invelis.style.transition = ''
        invelis.removeEventListener('transitionend', gata)
      }
      invelis.addEventListener('transitionend', gata)
      // Plasa de siguranta, daca transitionend nu ajunge sa fie emis.
      window.setTimeout(gata, 700)

      if (mutaFocus) file[i].focus()
    }

    file.forEach((f, i) => {
      f.addEventListener('click', () => alege(i))
      f.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return
        e.preventDefault()
        alege((i + (e.key === 'ArrowRight' ? 1 : file.length - 1)) % file.length, true)
      })
    })
  })
</script>
