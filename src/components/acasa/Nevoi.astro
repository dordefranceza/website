---
import { nevoi } from '../../config/continut'
import Semn from '../Semn.astro'
import PersonajCerc from '../PersonajCerc.astro'

const fundal = { albastru: 'bg-albastru-5', verde: 'bg-verde-5', portocaliu: 'bg-portocaliu-5', roz: 'bg-roz-5' }
---

<section id="pentru-ce" class="bg-crem py-20 sm:py-28" aria-labelledby="titlu-nevoi">
  <div class="container-site">
    {/* Textul tine doar 2xl latime, deci in dreapta lui ramane un gol cat un
        cerc. Figura arata cu palma deschisa spre stanga ei, adica inspre text
        si spre cardurile de dedesubt. De la 1280px in sus, altfel se inghesuie. */}
    <div class="flex items-end justify-between gap-12">
      <div class="dezvaluie max-w-2xl">
        <p class="eticheta">Pentru ce ai nevoie de franceză</p>
        <h2 id="titlu-nevoi" class="mt-3 text-4xl sm:text-5xl">Spune-mi ce vrei să obții. De acolo pornim.</h2>
        <p class="echilibrat mt-5 text-lg text-gri">Nu predau «franceză în general». Fiecare plan pleacă de la o situație reală din viața ta.</p>
      </div>
      <PersonajCerc nume="prezinta" inel="roz" disc="alb" marime={185} class="dezvaluie hidden xl:block" />
    </div>

    <div class="dezvaluie-rand mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {nevoi.map((n) => (
        <a href={`/programare/?scop=${encodeURIComponent(n.scop)}`} class="card-ridicat group flex flex-col rounded-[1.5rem] bg-alb p-7">
          <span class:list={['flex size-16 items-center justify-center rounded-2xl', fundal[n.culoare]]}>
            <Semn nume={n.semn as any} inaltime={34} />
          </span>
          <h3 class="mt-6 font-sans text-xl font-medium leading-snug">{n.titlu}</h3>
          <p class="mt-3 text-[0.98rem] leading-relaxed text-gri">{n.text}</p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-albastru-text">
            Programează pentru asta <span class="transition group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
