---
/**
 * Antetul paginii de start, dupa referinta August Health: titlu serif mare,
 * centrat, pe alb; in jur, cercuri colorate cu FOTOGRAFII, nu carduri de
 * interfata. Cardurile de dinainte imitau un produs software care aici nu
 * exista si nu spuneau nimic. Pozele spun: Paris, o masa de cafenea, un
 * birou cu laptopul deschis, si Dorina. Pe telefon ramane un singur cerc.
 */
import { Icon } from 'astro-icon/components'
import { site, linkWhatsApp } from '../../config/site'

/** Cercurile din jurul textului. Inelul colorat ramane vizibil in jurul pozei, ca in referinta. */
const cercuri = [
  { poza: '/images/dorina-placeholder.svg', alt: 'Dorina, profesoară de franceză', culoare: 'bg-roz', pozitie: 'left-[1%] top-[24%] size-[270px] xl:size-[320px]', anim: 'plutitor', intarziere: '0s' },
  { poza: '/images/antet-paris.webp', alt: '', culoare: 'bg-verde', pozitie: 'right-[2%] top-[9%] size-[220px] xl:size-[250px]', anim: 'plutitor-lent', intarziere: '-3s' },
  { poza: '/images/antet-cafenea.webp', alt: '', culoare: 'bg-albastru', pozitie: 'left-[5%] top-[64%] size-[240px] xl:size-[260px]', anim: 'plutitor', intarziere: '-2s' },
  { poza: '/images/antet-birou.webp', alt: '', culoare: 'bg-portocaliu', pozitie: 'right-[4%] top-[52%] size-[270px] xl:size-[300px]', anim: 'plutitor-lent', intarziere: '-5s' },
]
---

<section class="relative overflow-hidden bg-alb pt-32 sm:pt-40 lg:pt-44" aria-labelledby="titlu-antet">
  <div class="container-site relative z-10 flex flex-col items-center text-center">
    <a href="/#cum-decurge" class="intrare inline-flex items-center gap-2 rounded-full bg-albastru-5 px-4 py-2 text-sm font-medium text-navy transition hover:bg-albastru-10">
      Prima discuție e gratuită
      <Icon name="solar:arrow-right-linear" class="size-4" />
    </a>

    <h1 id="titlu-antet" class="intrare mt-7 max-w-3xl text-[2.7rem] leading-[1.02] sm:text-6xl lg:text-[4.25rem]" style="--intarziere:80ms">
      Franceza explicată simplu, <em class="not-italic text-albastru">pe înțelesul tău</em>
    </h1>

    <p class="intrare mt-6 max-w-2xl text-lg leading-relaxed text-gri sm:text-xl" style="--intarziere:160ms">
      Lecții individuale online cu Dorina, pentru adulți care au nevoie de franceză pentru ceva anume: un job, o mutare, un examen. Fără gramatică tocită, fără ore în care doar asculți. Vorbești din prima lecție.
    </p>

    <div class="intrare mt-9 flex flex-col items-center gap-3 sm:flex-row" style="--intarziere:240ms">
      <a href="/programare/" class="pastila pastila-albastra !px-7 !py-4 text-[1.05rem]">Programează o discuție gratuită</a>
      <a href={linkWhatsApp} target="_blank" rel="noopener" class="pastila pastila-crem !px-6 !py-4 text-[1.05rem]">
        <Icon name="solar:chat-round-line-bold" class="size-5 text-verde" /> Scrie pe WhatsApp
      </a>
    </div>

    <p class="intrare mt-4 text-sm text-gri" style="--intarziere:280ms">
      {site.durataCunoastere} de minute, pe Zoom. Fără plată și fără să te angajezi la nimic.
    </p>

    <ul class="intrare mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-sm font-medium text-gri" style="--intarziere:340ms">
      <li class="flex items-center gap-2"><Icon name="solar:user-check-rounded-bold" class="size-4 text-albastru" /> Același profesor, de fiecare dată</li>
      <li class="flex items-center gap-2"><Icon name="solar:clock-circle-bold" class="size-4 text-albastru" /> {site.durataLectie} de minute, pe Zoom</li>
      <li class="flex items-center gap-2"><Icon name="solar:chat-round-check-bold" class="size-4 text-albastru" /> Corectură pe WhatsApp între lecții</li>
    </ul>
  </div>

  {/* Cercurile cu fotografii, doar pe ecrane mari. Inelul colorat e de 14px. */}
  <div class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
    {
      cercuri.map((c) => (
        <div class:list={['absolute rounded-full p-3.5', c.culoare, c.pozitie, c.anim]} style={`animation-delay:${c.intarziere}`}>
          <img src={c.poza} alt={c.alt} class="size-full rounded-full object-cover" width="340" height="340" loading="lazy" decoding="async" />
        </div>
      ))
    }
  </div>

  {/* Pe telefon si tableta: cercul cu Dorina sub text */}
  <div class="container-site relative z-10 mt-12 flex justify-center lg:hidden">
    <div class="rounded-full bg-roz p-3">
      <img src="/images/dorina-placeholder.svg" alt="Dorina, profesoară de franceză" class="size-52 rounded-full object-cover sm:size-64" width="288" height="288" loading="eager" />
    </div>
  </div>

  {/* Banda crem ondulata, trecerea spre panza crem a paginii */}
  <div class="relative mt-16 h-24 lg:mt-40 lg:h-32" aria-hidden="true">
    <svg class="absolute inset-x-0 bottom-0 h-full w-full" viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path d="M0,60 C240,110 480,0 720,40 C960,80 1200,120 1440,50 L1440,120 L0,120 Z" fill="#f8f3eb" />
    </svg>
  </div>
</section>
