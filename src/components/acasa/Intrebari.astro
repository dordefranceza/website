---
import { Icon } from 'astro-icon/components'
import { intrebari } from '../../config/continut'
import Semn from '../Semn.astro'
import PersonajCerc from '../PersonajCerc.astro'
---

<section id="intrebari" class="bg-crem py-20 sm:py-28" aria-labelledby="titlu-intrebari">
  <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
    <div class="dezvaluie">
      <Semn nume="d-vorbire" inaltime={56} class="mb-5" />
      <p class="eticheta">Întrebări frecvente</p>
      <h2 id="titlu-intrebari" class="mt-3 text-4xl sm:text-5xl">Ce mă întreabă toți înainte să înceapă</h2>
      <p class="echilibrat mt-5 text-lg text-gri">Nu ai găsit răspunsul? Scrie-mi pe WhatsApp, de obicei răspund în aceeași zi.</p>
      {/* Langa randul despre WhatsApp, figura cu telefonul in mana. Doar de la
          1024px, unde coloana din stanga ramane goala sub text. */}
      <PersonajCerc nume="telefon" inel="verde" disc="alb" marime={190} marimeMare={190} class="mt-10 hidden lg:block" />
    </div>
    <div class="dezvaluie-rand space-y-3">
      {intrebari.map((i) => (
        <details class="group rounded-[1.25rem] bg-alb open:shadow-[var(--shadow-cald-md)]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-[1.05rem] font-medium marker:content-none [&::-webkit-details-marker]:hidden">
            {i.intrebare}
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-crem transition group-open:rotate-45"><Icon name="solar:add-circle-linear" class="size-5 text-albastru" /></span>
          </summary>
          <p class="px-6 pb-6 leading-relaxed text-gri">{i.raspuns}</p>
        </details>
      ))}
    </div>
  </div>
</section>
