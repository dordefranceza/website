---
/**
 * Ce spun cursantii. Daca lista e goala, sectiunea nu se randeaza deloc.
 * Regula: aici intra doar pareri reale, cu acordul omului. Nimic inventat.
 */
import { Icon } from 'astro-icon/components'
import { dovezi } from '../../config/continut'
---

{
  dovezi.length > 0 && (
    <section class="bg-alb py-20 sm:py-28" aria-labelledby="titlu-dovezi">
      <div class="container-site">
        <div class="dezvaluie max-w-2xl">
          <p class="eticheta">Ce spun cursanții</p>
          <h2 id="titlu-dovezi" class="mt-3 text-4xl sm:text-5xl">Oameni care au trecut pe aici</h2>
        </div>
        <div class="dezvaluie-rand mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {dovezi.map((d) => (
            <figure class="flex flex-col rounded-[1.5rem] bg-crem p-7">
              <Icon name="solar:chat-square-like-bold" class="size-7 text-roz" />
              <blockquote class="mt-5 flex-1 text-[1.02rem] leading-relaxed text-cerneala/90">{d.text}</blockquote>
              <figcaption class="mt-6">
                <span class="block font-medium">{d.nume}</span>
                <span class="block text-sm text-gri">{d.context}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
