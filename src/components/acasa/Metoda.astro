---
import { Icon } from 'astro-icon/components'
import { metoda } from '../../config/continut'
import PersonajCerc from '../PersonajCerc.astro'
---

<section class="bg-crem py-20 sm:py-28" aria-labelledby="titlu-metoda">
  <div class="container-site rounded-[2rem] bg-cerneala px-6 py-14 text-alb sm:px-12 sm:py-20">
    {/* Pe fundal inchis figura are nevoie de un disc deschis sub ea: conturul
        cobalt si bluza crem nu se vad direct pe negru. */}
    <div class="flex items-end justify-between gap-12">
      <div class="dezvaluie max-w-2xl">
        <p class="eticheta text-roz">De ce merge</p>
        <h2 id="titlu-metoda" class="mt-3 text-4xl sm:text-5xl">Nu înveți despre franceză. O vorbești.</h2>
      </div>
      <PersonajCerc nume="incurajeaza" inel="roz" disc="crem" marime={165} class="dezvaluie hidden lg:block" />
    </div>
    <div class="dezvaluie-rand mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {metoda.map((m) => (
        <div>
          <span class="flex size-11 items-center justify-center rounded-2xl bg-alb/10"><Icon name={m.icon} class="size-6 text-roz" /></span>
          <h3 class="mt-5 font-sans text-lg font-medium">{m.titlu}</h3>
          <p class="mt-2 leading-relaxed text-alb/70">{m.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
