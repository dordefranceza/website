---
/**
 * Raspunsul la obiectia de pret, pe fata. Fara linii despartitoare: coloanele
 * se separa prin fundal si spatiu.
 */
import { Icon } from 'astro-icon/components'
import { comparatie } from '../../config/continut'
import Semn from '../Semn.astro'
---

<section class="bg-alb py-20 sm:py-28" aria-labelledby="titlu-comparatie">
  <div class="container-site">
    <div class="dezvaluie mx-auto max-w-2xl text-center">
      <Semn nume="monograma-df" inaltime={54} class="mx-auto mb-5" />
      <p class="eticheta">Întrebarea despre preț</p>
      <h2 id="titlu-comparatie" class="mt-3 text-4xl sm:text-5xl">{comparatie.titlu}</h2>
      <p class="mt-5 text-lg text-gri">{comparatie.intro}</p>
    </div>

    <div class="dezvaluie mx-auto mt-12 max-w-4xl overflow-hidden rounded-[1.5rem]">
      <div class="grid grid-cols-2">
        <p class="bg-crem px-5 py-4 text-sm font-bold uppercase tracking-wider text-gri sm:px-7">{comparatie.coloane[0]}</p>
        <p class="bg-navy px-5 py-4 text-sm font-bold uppercase tracking-wider text-alb sm:px-7">{comparatie.coloane[1]}</p>
        {
          comparatie.randuri.map(([stanga, dreapta], i) => (
            <>
              <p class:list={['flex items-start gap-3 px-5 py-5 text-[0.98rem] leading-relaxed text-gri sm:px-7', i % 2 === 0 ? 'bg-crem' : 'bg-crem-inchis']}>
                <Icon name="solar:minus-circle-linear" class="mt-0.5 size-5 shrink-0 opacity-50" />
                <span>{stanga}</span>
              </p>
              <p class:list={['flex items-start gap-3 px-5 py-5 text-[0.98rem] leading-relaxed text-alb sm:px-7', i % 2 === 0 ? 'bg-navy' : 'bg-cerneala']}>
                <Icon name="solar:check-circle-bold" class="mt-0.5 size-5 shrink-0 text-verde-10" />
                <span>{dreapta}</span>
              </p>
            </>
          ))
        }
      </div>
    </div>

    <p class="dezvaluie mx-auto mt-8 max-w-2xl text-center text-lg leading-relaxed text-gri">{comparatie.concluzie}</p>
  </div>
</section>
