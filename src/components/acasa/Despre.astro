---
/**
 * Acelasi bloc apare in doua locuri, dar NU la fel.
 *
 * Pe pagina de start e teaser: fotografia, titlul, un singur paragraf si
 * legatura „Mai multe despre mine". Pe /despre/ e blocul intreg, cu toate
 * paragrafele, si fara legatura.
 *
 * Pana acum erau identice, iar legatura de pe pagina de start ducea la o pagina
 * care incepea exact cu ce tocmai citisei, cu aceeasi legatura care ducea la ea
 * insasi. Artiom a apasat-o si a intrebat, pe buna dreptate, ce s-a intamplat.
 */
import { Icon } from 'astro-icon/components'
import { despre } from '../../config/continut'

interface Props {
  /** 1 cand componenta e titlul paginii, 2 cand e o sectiune. */
  nivel?: 1 | 2
  /** true pe pagina de start: un singur paragraf si legatura spre /despre/ */
  scurt?: boolean
}
/**
 * `nivel` spune daca sectiunea e titlul paginii sau o bucata din ea.
 *
 * Componenta e folosita in doua locuri: ca sectiune pe pagina de start, unde
 * titlul paginii e altul si aici se cuvine un h2, si ca tot continutul paginii
 * /despre/, unde ea E titlul si trebuie sa fie h1. Scria h2 in amandoua, deci
 * /despre/ ajunsese pe internet fara niciun h1: Google nu avea de unde sti
 * despre ce e pagina. Gasit pe 13 septembrie 2026, citind HTML-ul livrat.
 */
const { scurt = false, nivel = 2 } = Astro.props
const Titlu = nivel === 1 ? 'h1' : 'h2'
const paragrafe = scurt ? despre.paragrafe.slice(0, 1) : despre.paragrafe
---

<section class="bg-alb py-20 sm:py-28" aria-labelledby="titlu-despre">
  <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="dezvaluie relative mx-auto w-full max-w-md">
      <div class="plutitor absolute -left-6 -top-6 size-28 rounded-full bg-portocaliu" aria-hidden="true"></div>
      <div class="plutitor-lent absolute -bottom-8 -right-4 size-36 rounded-full bg-albastru-10" aria-hidden="true"></div>
      <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-roz">
        <img src="/images/dorina-portret.webp" alt="Dorina, profesoară de franceză" class="absolute inset-0 size-full object-cover" width="480" height="600" loading="lazy" decoding="async" />
      </div>

      {/*
        Figura desenata sta langa fotografia adevarata, mare si fara cerc, cu
        privirea spre cititor. Aici e momentul in care vizitatorul leaga desenul
        de om: pana acum a vazut-o prezentand site-ul, aici afla cine e.
        Fara cerc dinadins: un cerculet mic aici arata a iconita lipita, iar
        Artiom l-a respins pe loc.
      */}
      <img
        src="/images/personaj/inima.webp"
        alt=""
        aria-hidden="true"
        width="310" height="640"
        class="pointer-events-none absolute -bottom-10 -left-20 hidden h-[300px] w-auto lg:block 2xl:-left-28 2xl:h-[340px]"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="dezvaluie">
      <p class="eticheta">Despre Dorina</p>
      <Titlu id="titlu-despre" class="mt-3 text-4xl sm:text-5xl">{despre.titlu}</Titlu>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-gri">
        {paragrafe.map((p) => <p>{p}</p>)}
      </div>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {despre.puncte.map((p) => (
          <li class="flex items-center gap-3 rounded-2xl bg-crem px-4 py-3 text-[0.95rem] font-medium">
            <Icon name={p.icon} class="size-5 shrink-0 text-albastru" /> {p.text}
          </li>
        ))}
      </ul>
      {scurt && (
        <a href="/despre/" class="mt-8 inline-flex items-center gap-1.5 font-medium text-albastru-text hover:underline">
          Mai multe despre mine <Icon name="solar:arrow-right-linear" class="size-4" />
        </a>
      )}
    </div>
  </div>
</section>
