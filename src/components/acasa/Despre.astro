---
import { Icon } from 'astro-icon/components'
import { despre } from '../../config/continut'
---

<section class="bg-alb py-20 sm:py-28" aria-labelledby="titlu-despre">
  <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="dezvaluie relative mx-auto w-full max-w-md">
      <div class="absolute -left-6 -top-6 size-28 rounded-full bg-portocaliu" aria-hidden="true"></div>
      <div class="absolute -bottom-8 -right-4 size-36 rounded-full bg-albastru-10" aria-hidden="true"></div>
      <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-roz">
        <img src="/images/dorina-placeholder.svg" alt="Dorina, profesoară de franceză" class="absolute inset-0 size-full object-cover" width="480" height="600" loading="lazy" />
      </div>
    </div>

    <div class="dezvaluie">
      <p class="eticheta">Despre Dorina</p>
      <h2 id="titlu-despre" class="mt-3 text-4xl sm:text-5xl">{despre.titlu}</h2>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-gri">
        {despre.paragrafe.map((p) => <p>{p}</p>)}
      </div>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {despre.puncte.map((p) => (
          <li class="flex items-center gap-3 rounded-2xl bg-crem px-4 py-3 text-[0.95rem] font-medium">
            <Icon name={p.icon} class="size-5 shrink-0 text-albastru" /> {p.text}
          </li>
        ))}
      </ul>
      <a href="/despre/" class="mt-8 inline-flex items-center gap-1.5 font-medium text-albastru-text hover:underline">
        Mai multe despre mine <Icon name="solar:arrow-right-linear" class="size-4" />
      </a>
    </div>
  </div>
</section>
