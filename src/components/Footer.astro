---
import Logo from './Logo.astro'
import { Icon } from 'astro-icon/components'
import { site, linkWhatsApp } from '../config/site'
import { firma, firmaCompleta } from '../config/firma'
import { intentii } from '../config/intentii'
import PersonajCerc from './PersonajCerc.astro'
const an = new Date().getFullYear()
---

<footer class="relative overflow-hidden bg-cerneala text-alb">
  {/*
    Personajul in subsol. Fundalul e inchis, deci figura are nevoie de un disc
    deschis sub ea: conturul cobalt si pantalonii bleumarin dispar pe negru.
    Coloanele se string putin de la 1280px in sus, ca sa-i faca loc.
  */}
  <PersonajCerc
    nume="asezata"
    inel="crem-inchis"
    disc="crem"
    marime={190}
    marimeMare={220}
    class="pointer-events-none absolute right-10 top-16 hidden xl:block 2xl:right-20"
  />

  <div class="container-site grid gap-10 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:py-20 xl:grid-cols-[1.25fr_0.9fr_0.9fr_0.7fr]">
    <div>
      <Logo pe="inchis" inaltime={26} />
      <p class="mt-5 max-w-sm text-[0.98rem] leading-relaxed text-alb/70">
        Lecții online de franceză, explicate în română, oriunde ai fi. Individual, {site.durataLectie} de minute, sau în grup mic, {site.durataGrup} de minute, pe Google Meet.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={linkWhatsApp} target="_blank" rel="noopener" class="pastila !py-3 bg-whatsapp text-cerneala hover:bg-[#1fbd5a]">
          <Icon name="whatsapp" class="size-5" /> Scrie pe WhatsApp
        </a>
        <a href="/programare/" class="pastila pastila-alba !py-3">Programează o discuție</a>
      </div>
    </div>

    {/*
      Pe telefon coloanele se aseaza una sub alta, iar lista de pagini e ingusta:
      ramane un gol cat toata jumatatea din dreapta. Figura din coltul de sus se
      vede doar de la 1280px, deci acolo golul ramanea gol. Acum il umple ea,
      mai mica si asezata langa lista.
    */}
    <nav aria-label="Pagini" class="flex items-center justify-between gap-6 md:block">
      <div>
      <p class="mb-4 text-sm font-bold uppercase tracking-wider text-alb/60">Pagini</p>
      <ul class="space-y-2.5 text-[0.98rem]">
        <li><a class="text-alb/80 hover:text-alb" href="/pentru-ce/">Pentru ce înveți</a></li>
        <li><a class="text-alb/80 hover:text-alb" href="/cum-decurge/">Cum decurge</a></li>
        <li><a class="text-alb/80 hover:text-alb" href="/preturi/">Prețuri</a></li>
        <li><a class="text-alb/80 hover:text-alb" href="/despre/">Despre Dorina</a></li>
        <li><a class="text-alb/80 hover:text-alb" href="/blog/">Blog</a></li>
        <li><a class="text-alb/80 hover:text-alb" href="/contact/">Contact</a></li>
        <li><a class="text-alb/80 hover:text-alb" href="/programare/">Programare</a></li>
      </ul>

      {/*
        Paginile pe intentie, legate din subsol ca sa fie gasite de pe orice
        pagina a site-ului.
        NU intra si in bara de sus: acolo sunt sase linkuri si incap fix, iar
        unsprezece ar inghesui-o. Artiom a lucrat mult la design si a cerut
        explicit sa nu fie stricat. Subsolul e locul firesc al unei liste lungi,
        si e de ajuns: Google urmareste linkurile de oriunde din pagina, nu doar
        din meniu.
      */}
      <p class="mb-4 mt-8 text-sm font-bold uppercase tracking-wider text-alb/60">Situații</p>
      <ul class="space-y-2.5 text-[0.98rem]">
        {intentii.map((i) => (
          <li><a class="text-alb/80 hover:text-alb" href={`/${i.slug}/`}>{i.meniu}</a></li>
        ))}
      </ul>
      </div>
      <PersonajCerc nume="asezata" inel="crem-inchis" disc="crem" marime={148} class="pointer-events-none shrink-0 md:hidden" />
    </nav>

    <div>
      <p class="mb-4 text-sm font-bold uppercase tracking-wider text-alb/60">Contact</p>
      <ul class="space-y-2.5 text-[0.98rem]">
        <li><a class="text-alb/80 hover:text-alb" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="text-alb/80 hover:text-alb" href={`tel:${site.telefon.replace(/\s/g, '')}`}>{site.telefon}</a></li>
        {site.instagram && <li><a class="text-alb/80 hover:text-alb" href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>}
        {site.tiktok && <li><a class="text-alb/80 hover:text-alb" href={site.tiktok} target="_blank" rel="noopener">TikTok</a></li>}
      </ul>
      {/* Datele de identificare apar DOAR cand exista cu adevarat. Cat timp
          firma nu e deschisa, aici scria „[Nume Prenume] PFA, CUI [CUI]", ceea
          ce arata a site neterminat si nu acopera pe nimeni juridic. Cand se
          completeaza `src/config/firma.ts`, blocul reapare singur. */}
      {firmaCompleta && (
        <>
          <p class="mb-3 mt-8 text-sm font-bold uppercase tracking-wider text-alb/60">Date de identificare</p>
          <p class="text-sm leading-relaxed text-alb/70">
            {firma.denumire}<br />
            IDNO {firma.cui} · {firma.registru}<br />
            {firma.sediu}
          </p>
        </>
      )}
    </div>
  </div>

  <div class="container-site flex flex-col gap-4 pb-10 text-sm text-alb/60">
    <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Pagini legale">
      <a class="hover:text-alb" href="/termeni/">Termeni și condiții</a>
      <a class="hover:text-alb" href="/confidentialitate/">Confidențialitate</a>
      <a class="hover:text-alb" href="/cookies/">Cookie-uri</a>
      <a class="hover:text-alb" href="/anulare-si-rambursare/">Anulare și rambursare</a>
      <a class="hover:text-alb" href="/credite/">Credite</a>
      <a class="hover:text-alb" href="/admin/">Cabinet</a>
    </nav>
    <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Protecția consumatorului">
      <a class="hover:text-alb" href={firma.consumatori} target="_blank" rel="noopener">Protecția consumatorilor</a>
    </nav>
    <p>© {an} {site.nume}. Toate drepturile rezervate.</p>
  </div>
</footer>
