---
/**
 * Sigla: numele „Dór de Franceza”, cu accentul albastru pe „o”.
 *
 * E un fișier generat și decupat, nu desen în cod. Marca „ó” separată a fost
 * scoasă din siglă la cererea lui Artiom: lângă nume nu își găsea locul.
 * A rămas doar ca iconiță de tab, unde nu încape un nume întreg.
 * Pe fundal închis, `brightness(0) invert(1)` face numele alb, fără al doilea fișier.
 */
interface Props {
  /** 'deschis' = antet alb, 'inchis' = subsol întunecat */
  pe?: 'deschis' | 'inchis'
  class?: string
  /** înălțimea numelui, în pixeli */
  inaltime?: number
}
const { pe = 'deschis', class: clasa = '', inaltime = 21 } = Astro.props
const alb = pe === 'inchis' ? 'filter:brightness(0) invert(1)' : ''
---

<span class:list={['inline-flex items-center', clasa]}>
  <img
    src="/images/semne/nume.webp"
    alt="Dór de Franceza"
    style={`height:${inaltime}px;width:auto;${alb}`}
    height={inaltime}
    loading="eager"
    decoding="async"
  />
</span>
