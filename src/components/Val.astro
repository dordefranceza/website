---
/**
 * Banda ondulata dintre o sectiune alba si panza crem a paginii.
 *
 * O SINGURA curba, nu mai multe suprapuse. Prima versiune avea trei valuri unul
 * peste altul si Artiom a vazut imediat ce era in neregula: „are colturi".
 * Avea dreptate. Cand doua curbe de aceeasi culoare se suprapun, conturul de sus
 * e invelisul lor, iar in fiecare punct de intersectie invelisul face un colt.
 * Oricat de netede ar fi curbele separat, reuniunea lor nu e neteda.
 *
 * Aici curba e una singura si e neteda peste tot, prin constructie: se calculeaza
 * analitic, punct cu punct, impreuna cu panta in fiecare punct, iar arcurile
 * cubice se leaga folosind chiar panta aia. Asa trecerea dintre arce nu se vede.
 *
 * Forma nu e un sinus curat, ca ar arata mecanic. E un sinus plus a doua lui
 * armonica, mult mai mica: tot o singura curba neteda, dar cu crestele si golurile
 * usor diferite intre ele, ca la apa adevarata. A doua armonica are exact perioada
 * pe jumatate, deci intregul se repeta la fel de curat si bucla se inchide.
 *
 * Miscarea: alunecare intr-o parte, plus o ridicare si coborare mai lenta, ca un
 * flux. Amandoua sunt transformari peste aceeasi curba, deci forma ramane neteda
 * tot timpul. Vitezele sunt cele cerute de Artiom: prima incercare, 46 de
 * secunde pentru un val intreg, i s-a parut prea lenta.
 */
interface Props {
  /** inaltimea benzii, clasele Tailwind */
  class?: string
  /** culoarea in care se varsa, adica fundalul sectiunii de dedesubt */
  culoare?: string
}
const { class: clasa = 'h-24 lg:h-32', culoare = '#f8f3eb' } = Astro.props

const LATIME = 1440
const INALTIME = 120

/** Lungimea unui val intreg. Mai lunga decat ecranul, ca sa se vada o singura unduire lata. */
const PERIOADA = 1900
/** Cat de adanc urca si coboara. */
const AMPLITUDINE = 30
/** A doua armonica, cea care scoate forma din sinusul perfect. */
const ARMONICA = 0.3
/** Inaltimea la care sta linia de mijloc, in sistemul viewBox. */
const MIJLOC = 56

/**
 * Curba, desenata cu arcuri cubice legate prin panta reala in fiecare punct.
 * Panta se ia din derivata functiei, nu se aproximeaza: de aia nu se vede
 * nicio imbinare intre arce.
 */
function curba(): string {
  const k = (2 * Math.PI) / PERIOADA
  const y = (x: number) => MIJLOC + AMPLITUDINE * Math.sin(k * x) + AMPLITUDINE * ARMONICA * Math.sin(2 * k * x + 1.1)
  const panta = (x: number) => AMPLITUDINE * k * Math.cos(k * x) + AMPLITUDINE * ARMONICA * 2 * k * Math.cos(2 * k * x + 1.1)

  const start = -PERIOADA
  const capat = LATIME + PERIOADA
  const pasi = 48
  const h = (capat - start) / pasi
  const r = (n: number) => Math.round(n * 100) / 100

  let d = `M${r(start)},${r(y(start))}`
  for (let i = 0; i < pasi; i++) {
    const x0 = start + i * h
    const x1 = x0 + h
    // Hermite spre Bezier: punctele de control stau la o treime de pas, pe panta
    d += ` C${r(x0 + h / 3)},${r(y(x0) + (panta(x0) * h) / 3)} ${r(x1 - h / 3)},${r(y(x1) - (panta(x1) * h) / 3)} ${r(x1)},${r(y(x1))}`
  }
  return `${d} L${r(capat)},${INALTIME} L${r(start)},${INALTIME} Z`
}

const D = curba()
---

<div class:list={['relative', clasa]} aria-hidden="true">
  {/*
    Valul coboara cu un pixel sub cutia lui.

    Marginea de jos a desenului cadea pe o fractiune de pixel, iar randul acela
    se amesteca intre cremul valului si albul sectiunii de deasupra. Iesea o
    dunga de un pixel, mai deschisa, pe toata latimea: masurata, la x=40 era
    #f9f5ef intre doua randuri de #f8f3eb. Artiom a incercuit-o pe telefon si
    avea dreptate, e chiar genul de linie despartitoare pe care a cerut sa nu le
    mai punem nicaieri.

    Coborat cu un pixel, randul de imbinare cade peste panza crem a paginii,
    adica crem peste crem, deci nu se mai vede. Valul nu se misca: ce se pierde
    e un pixel din partea plina de jos, care e oricum crem.
  */}
  <svg
    class="val-plutire absolute inset-x-0 -bottom-px h-[calc(100%+1px)] w-full"
    viewBox={`0 0 ${LATIME} ${INALTIME}`}
    preserveAspectRatio="none"
  >
    <g class="val-curge" style={`--p:${PERIOADA}`}>
      <path d={D} fill={culoare} />
    </g>
  </svg>
</div>

<style>
  /* Alunecarea: exact o perioada intreaga, deci la capat desenul e identic cu
     cel de la inceput si nu se vede nicio saritura. */
  .val-curge {
    animation: val-curge 24s linear infinite;
    will-change: transform;
  }
  @keyframes val-curge {
    from { transform: translateX(0); }
    to { transform: translateX(calc(var(--p) * -1px)); }
  }

  /* Fluxul: toata banda urca si coboara foarte putin, si mult mai incet. */
  .val-plutire {
    animation: val-plutire 11s ease-in-out infinite;
  }
  @keyframes val-plutire {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* Cine a cerut sistemului mai putina miscare primeste valul nemiscat. */
  @media (prefers-reduced-motion: reduce) {
    .val-curge,
    .val-plutire { animation: none; }
  }
</style>
