---
import Base from '../layouts/Base.astro'
import Preturi from '../components/acasa/Preturi.astro'
import Comparatie from '../components/acasa/Comparatie.astro'
import Intrebari from '../components/acasa/Intrebari.astro'
import Apel from '../components/acasa/Apel.astro'
import { site } from '../config/site'
---

<Base
  title="Prețuri · DorDeFranceza"
  description={`Lecție individuală de franceză ${site.preturi.individual} € pentru ${site.durataLectie} de minute, lecție în grup mic ${site.preturi.grup} €, pachete de 5 și 10 lecții cu reducere. Prima discuție de ${site.durataCunoastere} de minute e gratuită.`}
>
  <main id="continut" class="pt-24 sm:pt-28">
    <Preturi titlu="Știi de la început cât costă" />

    <section class="bg-alb py-16 sm:py-20">
      <div class="container-site grid gap-8 md:grid-cols-3">
        <div class="rounded-[1.5rem] bg-crem p-7">
          <h2 class="font-sans text-lg font-medium">Cum plătești</h2>
          <p class="mt-3 leading-relaxed text-gri">
            Prin transfer bancar sau Revolut, după fiecare lecție sau la finalul lunii. Nu există taxă de înscriere și niciun abonament care se reînnoiește singur.
          </p>
        </div>
        <div class="rounded-[1.5rem] bg-crem p-7">
          <h2 class="font-sans text-lg font-medium">Dacă nu poți ajunge</h2>
          <p class="mt-3 leading-relaxed text-gri">
            Reprogramezi gratuit cu cel puțin 24 de ore înainte. Sub 24 de ore, lecția se consideră făcută, pentru că ora a fost ținută pentru tine.
          </p>
        </div>
        <div class="rounded-[1.5rem] bg-crem p-7">
          <h2 class="font-sans text-lg font-medium">Ce nu plătești</h2>
          <p class="mt-3 leading-relaxed text-gri">
            Materialele sunt incluse, nu cumperi niciun manual. Discuția de cunoaștere e gratuită. Rezumatul lecției și corectura pe WhatsApp intră în preț.
          </p>
        </div>
      </div>
    </section>

    <Comparatie />
    <Intrebari />
    <Apel />
  </main>
</Base>
