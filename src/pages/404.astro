---
/** Pagina de 404. Desenul si textul stau in `Ratacit`, ca sa fie la fel si la blog. */
import Base from '../layouts/Base.astro'
import Ratacit from '../components/Ratacit.astro'
---
<Base title="Pagina nu există · DorDeFranceza" description="Pagina căutată nu există.">
  <Ratacit
    titlu="Pagina asta s-a rătăcit"
    text="Poate a fost mutată, poate nu a existat niciodată. Pagina de start e la un clic."
    buton="Înapoi acasă"
    href="/"
  />
</Base>
