---
/**
 * Un articol. Se genereaza la cerere, ca lista: un articol publicat din
 * cabinet apare fara redeploy. Raspunsul sta 5 minute pe CDN-ul Vercel.
 */
import Base from '../../layouts/Base.astro'
import Ratacit from '../../components/Ratacit.astro'
import Apel from '../../components/acasa/Apel.astro'
import type { Articol } from '../../lib/tipuri'
import { dataRo } from '../../lib/timp'
import { site } from '../../config/site'
import { depozit } from '../../server/depozit'
import { markdownLaHtml, minuteCitit, textSimplu } from '../../server/markdown'

export const prerender = false

const slug = Astro.params.slug ?? ''
let gasit: Articol | null = null
try {
  const a = /^[a-z0-9-]{1,80}$/.test(slug) ? await depozit().articol(slug) : null
  gasit = a && a.publicat ? a : null
} catch (e) {
  console.error('articol', e)
}

if (!gasit) {
  Astro.response.status = 404
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=60')
} else {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400')
}

const html = gasit ? markdownLaHtml(gasit.continut) : ''
const titlu = gasit ? gasit.meta_titlu || `${gasit.titlu} · DorDeFranceza` : 'Articolul nu există · DorDeFranceza'
const descriere = gasit ? gasit.meta_descriere || gasit.rezumat || textSimplu(gasit.continut) : 'Articolul căutat nu există sau nu mai e publicat.'
const schema = gasit
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: gasit.titlu,
      description: descriere,
      datePublished: gasit.publicat_la,
      dateModified: gasit.actualizat,
      inLanguage: 'ro',
      author: { '@type': 'Person', name: site.profesoara },
      publisher: { '@type': 'Organization', name: site.nume, url: site.url },
      mainEntityOfPage: `${site.url}/blog/${gasit.slug}/`,
      ...(gasit.imagine ? { image: gasit.imagine } : {}),
    }
  : null
---

<Base title={titlu} description={descriere} image={gasit?.imagine || undefined} noindex={!gasit}>
  {schema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />}
  {
    !gasit ? (
      /* Articolul negasit arata ca orice alta pagina negasita: acelasi desen cu
         cifrele si personajul care cauta. Pagina statica de 404 nu se poate
         chema de aici, fiindca pagina asta se randeaza la cerere si 404-ul
         static nu e in manifestul serverului. De aia desenul sta intr-o
         componenta. Fara apelul final dedesubt: pe o pagina care spune „nu am
         gasit", omul are nevoie de o iesire, nu de o oferta. */
      <Ratacit
        titlu="Articolul ăsta s-a rătăcit"
        text="Poate a fost retras, poate adresa e greșită. Celelalte articole sunt la un clic."
        buton="Toate articolele"
        href="/blog/"
      />
    ) : (
      <>
        <main id="continut" class="bg-crem pt-32 pb-8 sm:pt-40">
          <article class="container-site max-w-3xl rounded-[2rem] bg-alb px-6 py-10 sm:px-12 sm:py-14">
            <a href="/blog/" class="text-sm font-medium text-albastru-text">Toate articolele</a>
            <h1 class="mt-5 text-4xl sm:text-5xl">{gasit.titlu}</h1>
            <p class="mt-4 text-sm text-gri">
              {site.profesoara} · {gasit.publicat_la ? dataRo(gasit.publicat_la) : ''} · {minuteCitit(gasit.continut)} min de citit
            </p>
            {gasit.imagine && (
              <img src={gasit.imagine} alt={gasit.imagine_alt} class="mt-8 aspect-[16/9] w-full rounded-[1.5rem] object-cover" width="960" height="540" loading="eager" decoding="async" />
            )}
            <div
              class="articol mt-10 space-y-5 text-[1.08rem] leading-[1.75] text-cerneala/90 [&_a]:text-albastru-text [&_a]:underline [&_blockquote]:rounded-2xl [&_blockquote]:bg-crem [&_blockquote]:px-6 [&_blockquote]:py-4 [&_blockquote]:text-cerneala [&_code]:rounded [&_code]:bg-crem [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.95em] [&_h2]:mt-10 [&_h2]:text-3xl [&_h3]:mt-8 [&_h3]:font-sans [&_h3]:text-xl [&_h3]:font-medium [&_img]:rounded-2xl [&_li]:my-1 [&_ol]:list-decimal [&_ol]:pl-6 [&_strong]:font-bold [&_ul]:list-disc [&_ul]:pl-6 [&_table]:my-8 [&_table]:w-full [&_table]:border-collapse [&_table]:text-left [&_table]:text-[0.98rem] [&_th]:pb-3 [&_th]:pr-5 [&_th]:align-bottom [&_th]:font-sans [&_th]:text-xs [&_th]:font-bold [&_th]:uppercase [&_th]:tracking-wider [&_th]:text-gri [&_td]:px-5 [&_td]:py-3.5 [&_td]:align-top [&_th]:first:pl-5 [&_tbody_tr:nth-child(odd)_td]:bg-crem [&_tbody_tr_td:first-child]:rounded-l-xl [&_tbody_tr_td:last-child]:rounded-r-xl [&_tbody_tr_td:first-child]:font-medium [&_tbody_tr_td:first-child]:text-cerneala"
              set:html={html}
            />
          </article>
        </main>
        <div class="bg-crem pt-12"><Apel /></div>
      </>
    )
  }
</Base>
