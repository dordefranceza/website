---
import Base from '../layouts/Base.astro'
import { Icon } from 'astro-icon/components'
import FormularContact from '../components/FormularContact'
import { site, linkWhatsApp } from '../config/site'
import PersonajCerc from '../components/PersonajCerc.astro'
---

<Base title="Contact · DorDeFranceza" description="Scrie-i Dorinei pe WhatsApp, pe email sau prin formular. Răspunde în aceeași zi.">
  <main id="continut" class="bg-crem pt-32 pb-20 sm:pt-40 sm:pb-28">
    <div class="container-site grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <div>
        <p class="eticheta">Contact</p>
        {/* Titlul se rupea in doua, cu „WhatsApp" singur pe randul al doilea.
            Masurat: la 48px cere 548 de pixeli, iar coloana avea 487. Nu
            titlul a fost micsorat, ci coloana largita: formularul din dreapta
            incape si asa. */}
        <h1 class="mt-3 text-4xl sm:text-5xl lg:text-[2.6rem] xl:text-5xl">Cel mai rapid: WhatsApp</h1>
        <p class="echilibrat mt-5 text-lg text-gri">De obicei răspund în aceeași zi. Dacă preferi, îmi scrii pe email sau îți alegi direct o zi din calendar.</p>
        <div class="mt-8 space-y-3">
          <a href={linkWhatsApp} target="_blank" rel="noopener" class="flex items-center gap-4 rounded-[1.25rem] bg-alb p-5 transition hover:-translate-y-0.5">
            <span class="flex size-11 items-center justify-center rounded-full bg-verde-5"><Icon name="whatsapp" class="size-6 text-verde" /></span>
            <span><span class="block font-medium">WhatsApp</span><span class="text-sm text-gri">{site.telefon}</span></span>
          </a>
          <a href={`mailto:${site.email}`} class="flex items-center gap-4 rounded-[1.25rem] bg-alb p-5 transition hover:-translate-y-0.5">
            <span class="flex size-11 items-center justify-center rounded-full bg-albastru-5"><Icon name="solar:letter-bold" class="size-6 text-albastru" /></span>
            <span><span class="block font-medium">Email</span><span class="text-sm text-gri">{site.email}</span></span>
          </a>
          <a href="/programare/" class="flex items-center gap-4 rounded-[1.25rem] bg-alb p-5 transition hover:-translate-y-0.5">
            <span class="flex size-11 items-center justify-center rounded-full bg-portocaliu-5"><Icon name="solar:calendar-mark-bold" class="size-6 text-portocaliu" /></span>
            <span><span class="block font-medium">Programează direct</span><span class="text-sm text-gri">Alegi ziua și ora din calendar</span></span>
          </a>
        </div>
        {/* Umple golul de sub carduri, care apare doar cand cele doua coloane stau alaturi */}
        <PersonajCerc nume="telefon" inel="verde" disc="alb" marime={200} marimeMare={200} class="mt-10 hidden lg:block" />
      </div>
      <div class="rounded-[2rem] bg-alb p-6 sm:p-10">
        <h2 class="font-sans text-2xl font-medium">Sau lasă un mesaj</h2>
        <p class="echilibrat mt-2 text-gri">Îți răspund pe email sau pe telefon, cum preferi.</p>
        <FormularContact client:load />
      </div>
    </div>
  </main>
</Base>
